{
	"schemaVersion": 1,
	"id": "stash",
	"version": "${version}",
	"name": "Stash",
	"description": "Allows storing and retrieving items from a command-based storage area.",
	"authors": [
		"haykam821"
	],
	"contact": {
		"homepage": "https://github.com/haykam821/Stash#readme",
		"issues": "https://github.com/haykam821/Stash/issues"
	},
	"entrypoints": {
		"main": [
			"io.github.haykam821.stash.Main"
		],
		"client": [
			"io.github.haykam821.stash.client.ClientMain"
		],
        "cardinal-components-entity": [
            "io.github.haykam821.stash.component.StashComponentInitializer"
        ]
	},
	"accessWidener": "stash.accesswidener",
	"custom": {
		"cardinal-components": [
			"stash:stash"
		]
	},
	"license": "MIT",
	"icon": "assets/stash/icon.png",
	"depends": {
		"fabricloader": ">=0.4.0",
		"fabric-command-api-v2": ">=2.1.0",
		"fabric-resource-loader-v0": "*",
		"cardinal-components-entity": ">=3.0.0",
		"sgui": "*",
		"server_translations_api": "*",
		"fabric-permissions-api-v0": "*",
		"java": ">=21"
	},
	"suggests": {
		"libgui": "*",
		"placeholder-api": "*"
	}
}
